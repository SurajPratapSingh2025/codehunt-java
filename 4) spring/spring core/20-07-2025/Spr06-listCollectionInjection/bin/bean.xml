	<!-- List => Custom List -->
	<bean id="myList" class="java.util.LinkedList">
		<constructor-arg>
			<list>
				<value>hdfc</value>
				<value>sbi</value>
			</list>
		</constructor-arg>
	</bean>
	<bean id="myCar" class="com.mainapp.Car">
		<property name="price" value="992309"/>
		<property name="model" value="tata"/>
	</bean>
	<bean id="emp" class="com.mainapp.Employee">
		<property name="account" value="90205"/>
		<property name="bank" ref="myList"/>
		<property name="car" ref="myCar"/>
	</bean>
	
	
	
</beans>
