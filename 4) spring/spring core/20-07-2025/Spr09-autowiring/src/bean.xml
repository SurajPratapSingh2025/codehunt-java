<?xml version="1.0" encoding="UTF-8"?>

<beans 
	   default-autowire="byName"
	   xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    
    <bean id="acc1" class="com.mainapp.Account" primary="true">
        <property name="an" value="11111"/>
        <property name="bank" value="sbi"/>
    </bean>
    <bean id="acc" class="com.mainapp.Account" >
        <property name="an" value="22222"/>
        <property name="bank" value="hdfc"/>
    </bean>
    <bean id="acc3" class="com.mainapp.Account" autowire-candidate="false">
        <property name="an" value="33333"/>
        <property name="bank" value="bob"/>
    </bean>
    
    
    <bean id="emp" class="com.mainapp.Employee" autowire="constructor"/>

</beans>